{
  "name": "maestro-express-async-errors",
  "version": "1.2.8",
  "description": "TypeScript-first async error wrapper for Express, with optional Express 4 global patch and domain error routing.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.mjs",
      "require": "./dist/register.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjgouveia/maestro-express-async-errors.git"
  },
  "scripts": {
    "test": "mocha --require tsx/cjs \"test/**/*.ts\"",
    "test:types": "tsc -p tsconfig.types.json --noEmit",
    "coverage": "nyc -r text -r json-summary mocha --require tsx/cjs \"test/**/*.ts\"",
    "build": "tsup",
    "lint": "tsc",
    "ci": "npm run lint && npm run build && npm run test && npm run test:types",
    "semantic-release": "semantic-release --branches master",
    "commit": "git-cz",
    "acp": "git add . && npm run commit && git push"
  },
  "keywords": [
    "express",
    "async errors",
    "expressjs",
    "async",
    "error middleware",
    "await",
    "async/await",
    "error",
    "handling",
    "typescript",
    "express-async-handler",
    "error-handler"
  ],
  "author": "Jarbas Gouveia <gouvik.dev@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "express": ">=4.16.2"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.1",
    "@types/sinon": "^10.0.13",
    "@types/sinon-chai": "^3.2.9",
    "@types/supertest": "^6.0.2",
    "chai": "^4.3.4",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "express": "^4.21.2",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "semantic-release": "^25.0.9",
    "sinon": "^11.1.2",
    "sinon-chai": "^3.7.0",
    "supertest": "^7.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/jjgouveia/maestro-express-async-errors/issues"
  },
  "homepage": "https://github.com/jjgouveia/maestro-express-async-errors/#readme",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
